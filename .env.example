# Copy to .env.local and fill with your Supabase project credentials.
# Without these, the app runs on mock vehicle data (local demo mode).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional — server-only, for admin uploads / privileged ops
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

NEXT_PUBLIC_SITE_URL=https://www.carchoicebd.com
